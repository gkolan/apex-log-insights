{
  "name": "@apex-log-insights/core",
  "version": "1.1.33",
  "description": "Salesforce Apex debug log parser — shared parsing engine with zero runtime dependencies.",
  "author": "Gautam Kolan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkolan/apex-log-insights.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/gkolan/apex-log-insights/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/gkolan/apex-log-insights/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  }
}
