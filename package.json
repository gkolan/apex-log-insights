{
  "name": "apex-log-insights",
  "version": "1.2.0",
  "private": true,
  "description": "An offline toolkit that parses Salesforce Apex debug logs into structured reports.",
  "author": "Gautam Kolan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkolan/apex-log-insights.git"
  },
  "homepage": "https://github.com/gkolan/apex-log-insights",
  "bugs": {
    "url": "https://github.com/gkolan/apex-log-insights/issues"
  },
  "keywords": [
    "salesforce",
    "apex",
    "debug-log",
    "log-analyzer",
    "mcp",
    "chrome-extension",
    "firefox-extension",
    "edge-extension",
    "soql",
    "dml",
    "governor-limits",
    "cli"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "husky || true",
    "dev:cli": "pnpm --filter @apex-log-insights/cli dev",
    "dev:mcp": "pnpm --filter @apex-log-insights/mcp dev",
    "dev:ext": "pnpm --filter @apex-log-insights/browser-ext dev",
    "dev:vscode": "pnpm --filter ./packages/vscode-ext dev",
    "lint": "eslint packages/*/src packages/vscode-ext/scripts packages/vscode-ext/webview scripts viewer packages/browser-ext/shared vitest.config.mts",
    "format": "node --import tsx scripts/format-maintained.ts --write",
    "format:check": "node --import tsx scripts/format-maintained.ts --check",
    "typecheck": "pnpm --filter @apex-log-insights/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:vscode": "pnpm --dir packages/vscode-ext build && pnpm --dir packages/vscode-ext test:host",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "node --import tsx scripts/test-external-corpus.ts",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist",
    "check:version-sync": "node --import tsx scripts/check-version-sync.ts",
    "check:docs": "node --import tsx scripts/check-docs.ts && node --import tsx scripts/audit-docs.ts",
    "audit:docs": "node --import tsx scripts/audit-docs.ts",
    "validate": "pnpm export:extension:ui && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:version-sync && pnpm check:docs",
    "build": "pnpm -r build && pnpm run export:extension",
    "export:extension": "node --import tsx scripts/export-extension.ts",
    "export:extension:ui": "node --import tsx scripts/assemble-extension-ui.ts",
    "package:firefox-source": "node scripts/build-firefox-source.mjs",
    "version:bump": "node scripts/sync-versions.mjs",
    "audit:report": "node --import tsx scripts/run-audit.ts",
    "bugs:report": "node --import tsx scripts/run-bugs.ts",
    "release": "pnpm validate && pnpm build && pnpm --filter @apex-log-insights/core --filter @apex-log-insights/cli --filter @apex-log-insights/mcp publish --access public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.0.0",
    "knip": "^6.31.0",
    "lint-staged": "^15.0.0",
    "madge": "^8.0.0",
    "playwright-core": "1.62.1",
    "prettier": "^3.9.6",
    "secretlint": "^9.3.4",
    "tsx": "^4.23.1",
    "typescript": "~5.8",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": "0.16.8",
      "brace-expansion@<1.1.18": "1.1.18",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@<3.1.6": "3.1.6",
      "hono@<4.12.34": "4.12.34",
      "js-yaml@<4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.25": "8.5.25",
      "qs@<6.16.0": "6.16.0"
    }
  }
}
